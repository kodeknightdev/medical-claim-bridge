{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http": "Warning", "Quartz": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "PayersDb": "", "Redis": "", "Blob": "" },
  "Auth": { "Issuer": "http://localhost:5000/", "Authority": "http://localhost:5101/" },
  "Phi": { "Key": "" },
  "Kafka": { "BootstrapServers": "" },
  "Services": { "Claims": "http://localhost:5103/" },
  "Payers": {
    "PAYER-A": {
      "BaseUrl": "http://localhost:5109/",
      "CallbackUrl": "http://localhost:5105/api/payers/payer-a/callbacks/adjudication",
      "CallbackToken": "",
      "FileContainer": "payer-a",
      "RequestsPerSecond": 20,
      "MaxConcurrency": 8
    },
    "PAYER-B": {
      "BaseUrl": "http://localhost:5109/",
      "FileContainer": "payer-b",
      "RequestsPerSecond": 10,
      "MaxConcurrency": 4
    },
    "PAYER-C": {
      "BaseUrl": "http://localhost:5109/",
      "FileContainer": "payer-c",
      "RequestsPerSecond": 5,
      "MaxConcurrency": 2,
      "AttemptTimeoutSeconds": 2,
      "RetryCount": 2,
      "BreakSeconds": 20
    }
  },
  "Inquiry": { "SilentAfterMinutes": 10, "EveryMinutes": 10, "ScanSeconds": 60 },
  "Files": { "BatchWriterSeconds": 15, "PollSeconds": 10 },
  "Seed": { "Enabled": false }
}
