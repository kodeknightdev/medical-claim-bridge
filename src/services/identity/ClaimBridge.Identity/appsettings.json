{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "OpenIddict": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": ""
  },
  "Auth": {
    "Issuer": "http://localhost:5000/",
    "PortalRedirectUris": [ "http://localhost:4200/callback", "http://localhost:4200/silent-renew" ],
    "PortalPostLogoutUris": [ "http://localhost:4200/" ]
  },
  "Seed": {
    "Enabled": false,
    "DemoPassword": "",
    "DemoClientSecret": ""
  }
}
