{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "OpenIddict": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": "",
    "Redis": ""
  },
  "Auth": {
    "Issuer": "http://localhost:5080/",
    "PortalRedirectUris": [ "http://localhost:4200/callback", "http://localhost:4200/silent-renew" ],
    "PortalPostLogoutUris": [ "http://localhost:4200/" ],
    "Keys": {
      "SigningCertificatePath": "",
      "EncryptionCertificatePath": "",
      "CertificatePassword": ""
    }
  },
  "Seed": {
    "Enabled": false,
    "DemoPassword": "",
    "DemoClientSecret": ""
  }
}
