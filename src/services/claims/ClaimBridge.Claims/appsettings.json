{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "ClaimsDb": "", "Redis": "", "Blob": "" },
  "Auth": { "Issuer": "http://localhost:5000/", "Authority": "http://localhost:5101/" },
  "Phi": { "Key": "" },
  "Kafka": { "BootstrapServers": "" },
  "Services": {
    "ScrubberGrpc": "http://localhost:5114",
    "Providers": "http://localhost:5102/",
    "PayersGateway": "http://localhost:5105/",
    "DenialPredictor": "http://localhost:5108/"
  },
  "Lifecycle": {
    "AckSlaMinutes": { "PAYER-A": 5, "PAYER-B": 15, "PAYER-C": 5 },
    "InquiryWaitMinutes": 5,
    "MaxResubmissions": 1,
    "TimeoutScanSeconds": 20
  },
  "Seed": { "Enabled": false }
}
