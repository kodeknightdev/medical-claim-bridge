{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "NotificationsDb": "", "Redis": "" },
  "Auth": { "Issuer": "http://localhost:5080/", "Authority": "http://localhost:5101/" },
  "Kafka": { "BootstrapServers": "" },
  "Services": { "Providers": "http://localhost:5102/" },
  "Webhooks": {
    "BackoffSeconds": [ 10, 30, 120, 600, 1800, 3600, 10800, 21600 ],
    "DisableAfterConsecutiveFailures": 15,
    "TimeoutSeconds": 10
  },
  "Smtp": { "Host": "localhost", "Port": 1025, "From": "no-reply@claimbridge.local" },
  "Seed": { "Enabled": false }
}
