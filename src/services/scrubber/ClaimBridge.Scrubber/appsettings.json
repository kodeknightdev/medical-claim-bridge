{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8080", "Protocols": "Http1" },
      "Grpc": { "Url": "http://+:8081", "Protocols": "Http2" }
    }
  },
  "ConnectionStrings": { "ScrubberDb": "", "Redis": "" },
  "Auth": { "Issuer": "http://localhost:5000/", "Authority": "http://localhost:5101/" },
  "Seed": { "Enabled": false }
}
