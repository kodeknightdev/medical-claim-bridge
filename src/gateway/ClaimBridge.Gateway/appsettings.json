{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "http://localhost:5000/",
    "Authority": "http://localhost:5101/"
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200"
    ]
  },
  "RateLimiting": {
    "UserPerMinute": 600,
    "AnonymousPerMinute": 120
  },
  "ReverseProxy": {
    "Routes": {
      "identity-connect": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/connect/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-client"
      },
      "identity-discovery": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "identity-account": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/account/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-client"
      },
      "identity-clients": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/clients/{**catch-all}"
